{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "comparison"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "evaluation_status": {
      "enum": [
        "not_evaluated",
        "passed",
        "review_required",
        "failed",
        "insufficient_evidence"
      ]
    },
    "baseline": {
      "type": "object"
    },
    "candidate": {
      "type": "object"
    },
    "protocol": {
      "type": "object"
    },
    "selection": {
      "type": "object"
    },
    "condition_differences": {
      "type": "array"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "measurements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/measurement"
            }
          },
          "region_readouts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/colorReadout"
            }
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "regions": {
            "type": "array"
          },
          "automatic_regions": {
            "type": "array"
          },
          "artifacts": {
            "type": "array"
          },
          "baseline_source": {
            "type": "object"
          },
          "candidate_source": {
            "type": "object"
          },
          "review": {
            "type": "object"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "summary": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "layout": {
            "type": "object"
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "role"
        ],
        "additionalProperties": true
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "binary": {
      "enum": [
        "spektrafilm-lab",
        "spektrafilm-bench"
      ]
    },
    "protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "map_scale": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "execution_status",
    "protocol",
    "selection",
    "condition_differences",
    "cases",
    "summary",
    "artifacts",
    "baseline",
    "candidate",
    "protocol_digest",
    "map_scale"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpektraFilm comparison version 1",
  "$defs": {
    "measurement": {
      "type": "object",
      "required": [
        "region_id",
        "metric",
        "metric_version",
        "domain",
        "units",
        "estimator",
        "artifact_refs",
        "availability"
      ],
      "properties": {
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed_population": {
          "type": "array"
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "baseline",
            "candidate",
            "delta"
          ]
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "metric_version": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "estimator": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "value": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reference_id": {
          "type": "string"
        },
        "protocol_id": {}
      },
      "additionalProperties": false
    },
    "triple": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "readoutObservation": {
      "type": "object",
      "required": [
        "availability"
      ],
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "availability": {
            "const": "available"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ],
        "not": {
          "required": [
            "reason"
          ]
        }
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    "scalarObservation": {
      "allOf": [
        {
          "$ref": "#/$defs/readoutObservation"
        },
        {
          "properties": {
            "value": {
              "type": "number"
            }
          }
        }
      ]
    },
    "vectorObservation": {
      "allOf": [
        {
          "$ref": "#/$defs/readoutObservation"
        },
        {
          "properties": {
            "value": {
              "$ref": "#/$defs/triple"
            }
          }
        }
      ]
    },
    "colorSide": {
      "type": "object",
      "required": [
        "lab",
        "lch",
        "geometry",
        "coordinate_space",
        "sample_count"
      ],
      "properties": {
        "lab": {
          "$ref": "#/$defs/triple"
        },
        "mean_linear_srgb": {
          "$ref": "#/$defs/triple"
        },
        "lch": {
          "type": "object",
          "required": [
            "l_star",
            "c_star",
            "h_degrees"
          ],
          "properties": {
            "l_star": {
              "type": "number"
            },
            "c_star": {
              "type": "number",
              "minimum": 0
            },
            "h_degrees": {
              "$ref": "#/$defs/scalarObservation"
            }
          }
        },
        "geometry": {
          "type": [
            "array",
            "object"
          ]
        },
        "coordinate_space": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "colorReadout": {
      "description": "Comparison-owned regional color centers and signed to-minus-from vectors; not pixel-map aggregates.",
      "type": "object",
      "required": [
        "region_id",
        "pair_id",
        "estimator",
        "domain",
        "readout_version",
        "white_point",
        "observer",
        "availability",
        "artifact_refs"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "pair_id": {
          "enum": [
            "baseline/candidate",
            "input",
            "reference"
          ]
        },
        "estimator": {
          "enum": [
            "bounded_lab_channel_median",
            "unclipped_linear_srgb_mean"
          ]
        },
        "domain": {
          "enum": [
            "bounded_srgb_d65_lab",
            "unclipped_linear_srgb_mean_lab"
          ]
        },
        "readout_version": {
          "const": "color-region-v1"
        },
        "white_point": {
          "const": "D65"
        },
        "observer": {
          "const": "CIE1931_2deg"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "eligibility": {
          "type": "object",
          "required": [
            "tone",
            "chroma"
          ],
          "properties": {
            "tone": {
              "type": "boolean"
            },
            "chroma": {
              "type": "boolean"
            }
          }
        },
        "sides": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "$ref": "#/$defs/colorSide"
          }
        },
        "displacements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from_role",
              "to_role",
              "delta_lab",
              "delta_l_star",
              "delta_c_star",
              "delta_h_degrees",
              "delta_e76",
              "delta_e00",
              "equal_l_delta_e00"
            ],
            "properties": {
              "from_role": {
                "type": "string",
                "minLength": 1
              },
              "to_role": {
                "type": "string",
                "minLength": 1
              },
              "delta_lab": {
                "$ref": "#/$defs/vectorObservation"
              },
              "delta_l_star": {
                "$ref": "#/$defs/scalarObservation"
              },
              "delta_c_star": {
                "$ref": "#/$defs/scalarObservation"
              },
              "delta_h_degrees": {
                "$ref": "#/$defs/scalarObservation"
              },
              "delta_e76": {
                "$ref": "#/$defs/scalarObservation"
              },
              "delta_e00": {
                "$ref": "#/$defs/scalarObservation"
              },
              "equal_l_delta_e00": {
                "$ref": "#/$defs/scalarObservation"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "availability": {
            "const": "available"
          }
        }
      },
      "then": {
        "required": [
          "sides",
          "displacements"
        ],
        "not": {
          "required": [
            "reason"
          ]
        }
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "sides"
              ]
            },
            {
              "required": [
                "displacements"
              ]
            }
          ]
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "availability"
      ],
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "enum": [
                  "unavailable",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
