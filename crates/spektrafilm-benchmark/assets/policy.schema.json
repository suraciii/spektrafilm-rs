{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibration": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "calibrated",
            "exploratory"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "observation_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "purpose": {
            "enum": [
              "protect",
              "expect",
              "reference"
            ]
          },
          "selector": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "region_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              }
            },
            "required": [
              "case_id",
              "region_id"
            ],
            "additionalProperties": false
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "direction": {
            "enum": [
              "increase",
              "decrease",
              "unchanged"
            ]
          }
        },
        "required": [
          "id",
          "purpose",
          "selector",
          "metric",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "protocol_digest",
    "calibration",
    "rules"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpektraFilm benchmark policy version 1"
}
