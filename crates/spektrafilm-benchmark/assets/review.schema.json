{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": false,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "grid": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "integer",
                "minimum": 1
              },
              "columns": {
                "type": "integer",
                "minimum": 1
              },
              "origin": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": false,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "patch_size": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": false,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "gap": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": false,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "rows",
              "columns",
              "origin",
              "patch_size",
              "gap"
            ],
            "additionalProperties": false
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "geometry": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "uniqueItems": false,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "required": [
                "id",
                "label",
                "geometry"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "grid"
            ]
          },
          {
            "required": [
              "regions"
            ]
          }
        ]
      }
    },
    "images": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": false,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "set": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "color_space": {
            "type": "string",
            "minLength": 1
          },
          "cctf_decoding": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "set",
          "path",
          "label",
          "color_space",
          "cctf_decoding"
        ],
        "additionalProperties": false
      }
    },
    "default_pair": {
      "type": "object",
      "properties": {
        "left": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "right": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "title",
    "sets",
    "images",
    "default_pair"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpektraFilm prepared image review version 1"
}
