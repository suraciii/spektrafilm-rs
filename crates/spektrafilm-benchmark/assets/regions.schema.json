{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "partition": {
            "type": "string"
          },
          "role": {
            "enum": [
              "skin",
              "neutral",
              "shadow",
              "highlight",
              "color",
              "flat_field",
              "edge",
              "texture",
              "other",
              "full_image"
            ]
          },
          "measurements": {
            "type": "array",
            "items": {
              "enum": [
                "numeric",
                "color",
                "tone",
                "flip",
                "grain",
                "halation",
                "edge"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "geometry": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "space": {
                    "enum": [
                      "source",
                      "render"
                    ]
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height",
                  "space"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "space": {
                    "enum": [
                      "source",
                      "render"
                    ]
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "width",
                  "height",
                  "space"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "role",
          "geometry",
          "measurements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "regions"
  ],
  "additionalProperties": false
}
