{
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "resolved" },
    "id": { "type": "string" },
    "execution_status": {
      "type": "string",
      "enum": ["completed", "failed", "validated", "not_evaluated"]
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "kind"],
  "additionalProperties": true
}
