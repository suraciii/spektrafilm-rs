{
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "execution_status": {
      "type": "string",
      "enum": ["completed", "failed"]
    },
    "host_precision": { "type": "string" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "availability": {
            "type": "string",
            "enum": ["available", "unavailable", "not_applicable"]
          },
          "domain": { "type": "string" },
          "units": { "type": "string" },
          "geometry": {
            "type": "object",
            "properties": {
              "coordinate_space": {
                "enum": ["source_pixels", "working_pixels", "film_frame_pixels", "grain_aperture_pixels", "output_pixels"]
              }
            },
            "required": ["coordinate_space"],
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "channels": { "type": "integer", "minimum": 1 },
              "dtype": { "type": "string" },
              "endianness": { "type": "string" },
              "channel_order": { "type": "string" }
            },
            "required": ["width", "height", "channels", "dtype", "endianness"],
            "additionalProperties": false
          }
        },
        "required": ["id", "path", "sha256", "availability"],
        "additionalProperties": false
      }
    },
    "terminal_cmyk": {
      "type": "object",
      "description": "The terminal CMYK ink style appearance as the executed render applied it, after rgb_out collection and before output mix. It is an appearance on the same three-channel RGB buffer, never a spectral stage: no buffer, no seventh stage id, no CMY channel claim. Available only when the runtime actually executed the stage; disabled and strength-zero runs stay not_applicable with a stable reason and carry no strength claim.",
      "properties": {
        "availability": {
          "type": "string",
          "enum": ["available", "not_applicable"]
        },
        "style": {
          "type": "string",
          "enum": ["ink"]
        },
        "model": {
          "type": "string",
          "enum": ["cmyk_ink_v1"]
        },
        "strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "boundary": {
          "type": "string",
          "enum": ["post_rgb_out"]
        },
        "color_space": {
          "type": "string",
          "minLength": 1
        },
        "cctf_encoding": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "required": ["availability"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "execution_status", "host_precision", "stages", "terminal_cmyk"],
  "additionalProperties": false
}
