{
  "schema_version": 1,
  "title": "规范色卡查看示例",
  "description": "生成器内置的合成探针，不是实测胶片数据。两个色卡组没有色块语义对应；请选择任意图像和窗口作视觉检查。",
  "charts": [
    {
      "id": "color-probe",
      "label": "八色探针",
      "grid": {
        "rows": 1,
        "columns": 8,
        "origin": [0, 32],
        "patch_size": [16, 96],
        "gap": [0, 0]
      }
    },
    {
      "id": "flat-probe",
      "label": "四级平场探针",
      "grid": {
        "rows": 1,
        "columns": 4,
        "origin": [0, 0],
        "patch_size": [32, 128],
        "gap": [0, 0]
      }
    }
  ],
  "images": [
    {
      "id": "colors",
      "chart": "color-probe",
      "path": "chart.png",
      "label": "合成彩色探针",
      "description": "顶部渐变不属于声明的色块窗口。",
      "color_space": "sRGB",
      "cctf_decoding": true
    },
    {
      "id": "flat-fields",
      "chart": "flat-probe",
      "path": "flat_fields.png",
      "label": "合成平场探针",
      "description": "独立的四级布局，不与左图逐块建立对应。",
      "color_space": "sRGB",
      "cctf_decoding": true
    }
  ],
  "default_pair": {
    "left": "colors",
    "right": "flat-fields"
  }
}
