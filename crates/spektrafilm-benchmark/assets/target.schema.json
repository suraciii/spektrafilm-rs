{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "renderer": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "data_dir": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": [
        "cpu",
        "gpu"
      ]
    },
    "changes": {
      "type": "object",
      "properties": {
        "set_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "set": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "set_files",
        "set"
      ],
      "additionalProperties": false
    },
    "case_changes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "set_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "set": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": false
          }
        },
        "required": [
          "set_files",
          "set"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "RAYON_NUM_THREADS": {
          "type": "string",
          "minLength": 1
        },
        "OPENBLAS_NUM_THREADS": {
          "type": "string",
          "minLength": 1
        },
        "OMP_NUM_THREADS": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "renderer",
    "data_dir",
    "backend",
    "changes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpektraFilm benchmark target version 1"
}
